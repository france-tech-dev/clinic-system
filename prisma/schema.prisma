// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OWNER
  MANAGER
  MEMBER
  CLIENT
}

enum PatientStatus {
  active
  discharged
  paused
}

enum MemberStatus {
  active
  inactive
}

enum SessionNoteStatus {
  attended
  absent
  cancelled
}

enum AppointmentStatus {
  scheduled
  completed
  absent
  cancelled
}

enum CashTransactionType {
  income
  expense
}

enum CashPaymentMethod {
  cash
  pix
  card
  transfer
  other
}

enum PatientPricingType {
  session
  package
}

enum PatientSex {
  female
  male
  other
  not_informed
}

enum BillingPlan {
  starter
  pro
  enterprise
}

enum BillingStatus {
  trialing
  active
  past_due
  canceled
  unpaid
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      Boolean   @default(false) @map("email_verified")
  image              String?
  phone              String?
  birthDate          DateTime? @map("birth_date")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  accounts           Account[]
  sessions           Session[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     Member[]
  invitations Invitation[]
  guardian    Guardian?

  @@map("users")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

// Organizações
model Organization {
  id                  String               @id
  name                String
  slug                String
  logo                String?
  createdAt           DateTime
  metadata            String?
  members             Member[]
  invitations         Invitation[]
  patients            Patient[]
  guardians           Guardian[]
  appointments        Appointment[]
  cashTransactions    CashTransaction[]
  protocolEvaluations ProtocolEvaluation[]
  anamneses           Anamnese[]
  billing             OrganizationBilling?
  /** Acesso completo sem cobrança — gerido em /plataforma. */
  billingExempt       Boolean              @default(false) @map("billing_exempt")

  @@unique([slug])
  @@map("organization")
}

model OrganizationBilling {
  id                   String        @id @default(cuid())
  organizationId       String        @unique
  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stripeCustomerId     String        @unique
  stripeSubscriptionId String        @unique
  status               BillingStatus
  plan                 BillingPlan?
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([stripeCustomerId])
  @@map("organization_billing")
}

// Responsáveis
model Guardian {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name             String
  phone            String       @default("")
  email            String?
  cpf              String?
  address          String       @default("")
  zipCode          String       @default("") @map("zip_code")
  documentImageUrl String?      @map("document_image_url")
  insurance        String       @default("particular")
  motherName       String       @default("") @map("mother_name")
  motherCpf        String?      @map("mother_cpf")
  fatherName       String       @default("") @map("father_name")
  fatherCpf        String?      @map("father_cpf")
  userId           String?      @unique @map("user_id")
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  patients         Patient[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, cpf])
  @@index([organizationId])
  @@map("guardians")
}

// Pacientes
model Patient {
  id                  String               @id @default(cuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  guardianId          String
  guardian            Guardian             @relation(fields: [guardianId], references: [id], onDelete: Restrict)
  name                String
  birthDate           DateTime?            @map("birth_date")
  sex                 PatientSex           @default(not_informed)
  photoUrl            String?              @map("photo_url")
  notes               String               @default("")
  status              PatientStatus        @default(active)
  pricingType         PatientPricingType   @default(session)
  price               Decimal?             @db.Decimal(12, 2)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  clinicalEvaluations ClinicalEvaluation[]
  anamneses           Anamnese[]
  sessionNotes        SessionNote[]
  appointments        Appointment[]
  roteiroNotes        RoteiroNote[]
  cashTransactions    CashTransaction[]
  protocolEvaluations ProtocolEvaluation[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([guardianId])
  @@map("patients")
}

// Avaliações clínicas (prontuário — narrativa + domínios)
model ClinicalEvaluation {
  id                String   @id @default(cuid())
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  memberId          String?
  member            Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  type              String   @default("initial")
  date              String
  complaint         String   @default("")
  history           String   @default("")
  domains           String
  goals             String   @default("")
  interventions     String   @default("")
  diagnosis         String   @default("")
  referredBy        String   @default("")
  familyContext     String   @default("")
  previousLevel     String   @default("")
  medications       String   @default("")
  precautions       String   @default("")
  equipment         String   @default("")
  frequency         String   @default("")
  dischargeCriteria String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([patientId])
  @@index([patientId, date])
  @@index([memberId])
  @@map("clinical_evaluations")
}

// Anamnese (1 por paciente × formulário/especialidade)
model Anamnese {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  formId         String
  data           String       @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([patientId, formId])
  @@index([organizationId])
  @@index([patientId])
  @@map("anamneses")
}

// Notas de sessão
model SessionNote {
  id            String            @id @default(cuid())
  patientId     String
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  memberId      String?
  member        Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  appointmentId String?           @unique
  appointment   Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  date          String
  time          String            @default("")
  status        SessionNoteStatus @default(attended)
  activities    String            @default("")
  observations  String            @default("")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([patientId])
  @@index([patientId, date])
  @@index([memberId])
  @@map("session_notes")
}

// Agendamentos
model Appointment {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  date           String
  time           String            @default("")
  duration       Int               @default(45)
  notes          String            @default("")
  status         AppointmentStatus @default(scheduled)
  sessionNote    SessionNote?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId])
  @@index([organizationId, date])
  @@index([patientId])
  @@index([memberId])
  @@map("appointments")
}

// Transações financeiras
model CashTransaction {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           CashTransactionType
  amount         Decimal             @db.Decimal(12, 2)
  date           String
  description    String              @default("")
  paymentMethod  CashPaymentMethod   @default(cash)
  patientId      String?
  patient        Patient?            @relation(fields: [patientId], references: [id], onDelete: SetNull)
  memberId       String?
  member         Member?             @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId])
  @@index([organizationId, date])
  @@index([patientId])
  @@index([memberId])
  @@map("cash_transactions")
}

// Notas do roteiro de avaliações
model RoteiroNote {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  roteiroId    String
  categoryTick String
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([patientId, roteiroId, categoryTick])
  @@index([patientId])
  @@index([patientId, roteiroId])
  @@map("roteiro_notes")
}

// Avaliações de protocolo (instrumentos pontuados, ex. GMFM-88)
model ProtocolEvaluation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  memberId       String?
  member         Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  protocolId     String
  label          String       @default("Evaluation")
  date           String
  scores         String
  notes          String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([patientId])
  @@index([patientId, protocolId])
  @@index([memberId])
  @@map("protocol_evaluations")
}

// Profissionais
model Member {
  id                  String               @id
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                Role                 @default(MEMBER)
  status              MemberStatus         @default(active)
  profession          String?
  registration        String?
  metadata            String?
  createdAt           DateTime
  appointments        Appointment[]
  cashTransactions    CashTransaction[]
  clinicalEvaluations ClinicalEvaluation[]
  sessionNotes        SessionNote[]
  protocolEvaluations ProtocolEvaluation[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([userId])
  @@map("member")
}

// Convites
model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}
