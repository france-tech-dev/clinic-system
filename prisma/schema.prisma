// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"
}

datasource db {
  // provider = "postgresql"
  provider = "sqlite"
}

enum Role {
  ADMIN
  OWNER
  MANAGER
  MEMBER
  CLIENT
}

enum PatientStatus {
  ativo
  alta
  pausado
}

enum SessionNoteStatus {
  compareceu
  faltou
  cancelado
}

enum AppointmentStatus {
  agendado
  realizado
  faltou
  cancelado
}

enum CashTransactionType {
  entrada
  saida
}

enum CashPaymentMethod {
  dinheiro
  pix
  cartao
  transferencia
  outro
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  role          Role      @default(MEMBER)
  accounts      Account[]
  sessions      Session[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     Member[]
  invitations Invitation[]

  @@map("users")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
  @@index([userId])
}

model Session {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  exercises    Exercise[]
  patients     Patient[]
  appointments Appointment[]
  studyCards   StudyCard[]
  cashTransactions CashTransaction[]

  @@unique([slug])
  @@map("organization")
}

model Exercise {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  categoryId     String
  objective      String
  materials      String
  instructions   String
  duration       String
  level          String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  planItems      PatientPlanItem[]

  @@index([organizationId])
  @@index([organizationId, categoryId])
  @@map("exercises")
}

model StudyCard {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  categoryId     String
  content        String
  isCustom       Boolean      @default(true)
  seedKey        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, seedKey])
  @@index([organizationId])
  @@index([organizationId, categoryId])
  @@map("study_cards")
}

model Patient {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  notes          String            @default("")
  status         PatientStatus     @default(ativo)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  planItems      PatientPlanItem[]
  evaluations    Evaluation[]
  anamnese       Anamnese?
  sessionNotes   SessionNote[]
  appointments   Appointment[]
  roteiroNotes   RoteiroNote[]
  cashTransactions CashTransaction[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("patients")
}

model PatientPlanItem {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([patientId, exerciseId])
  @@index([patientId])
  @@index([exerciseId])
  @@map("patient_plan_items")
}

model Evaluation {
  id                String   @id @default(cuid())
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tipo              String   @default("inicial")
  date              String
  queixa            String   @default("")
  historia          String   @default("")
  domains           String
  objetivos         String   @default("")
  condutas          String   @default("")
  diagnostico       String   @default("")
  encaminhadoPor    String   @default("")
  contextoFamiliar  String   @default("")
  nivelPrevio       String   @default("")
  medicacoes        String   @default("")
  precaucoes        String   @default("")
  equipamentos      String   @default("")
  frequencia        String   @default("")
  criteriosAlta     String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([patientId])
  @@index([patientId, date])
  @@map("evaluations")
}

model Anamnese {
  id        String   @id @default(cuid())
  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  data      String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("anamneses")
}

model SessionNote {
  id          String            @id @default(cuid())
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date        String
  status      SessionNoteStatus @default(compareceu)
  atividades  String            @default("")
  observacoes String            @default("")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([patientId])
  @@index([patientId, date])
  @@map("session_notes")
}

model Appointment {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date           String
  time           String            @default("")
  duration       Int               @default(50)
  notes          String            @default("")
  status         AppointmentStatus @default(agendado)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId])
  @@index([organizationId, date])
  @@index([patientId])
  @@map("appointments")
}

model CashTransaction {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           CashTransactionType
  amountCents    Int
  date           String
  description    String              @default("")
  paymentMethod  CashPaymentMethod   @default(dinheiro)
  patientId      String?
  patient        Patient?            @relation(fields: [patientId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId])
  @@index([organizationId, date])
  @@index([patientId])
  @@map("cash_transactions")
}

model RoteiroNote {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  roteiroId    String
  categoryTick String
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([patientId, roteiroId, categoryTick])
  @@index([patientId])
  @@index([patientId, roteiroId])
  @@map("roteiro_notes")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}
