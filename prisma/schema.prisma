// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/prisma"
}

datasource db {
  // provider = "postgresql"
  provider = "sqlite"
}

enum Role {
  ADMIN
  OWNER
  MANAGER
  MEMBER
  CLIENT
}

enum PatientStatus {
  ativo
  alta
  pausado
}

enum SessionNoteStatus {
  compareceu
  faltou
  cancelado
}

enum AppointmentStatus {
  agendado
  realizado
  faltou
  cancelado
}

enum CashTransactionType {
  entrada
  saida
}

enum CashPaymentMethod {
  dinheiro
  pix
  cartao
  transferencia
  outro
}

enum PatientPricingType {
  sessao
  pacote
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      Boolean   @default(false) @map("email_verified")
  image              String?
  phone              String?
  birthDate          DateTime? @map("birth_date")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  accounts           Account[]
  sessions           Session[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     Member[]
  invitations Invitation[]

  @@map("users")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
  @@index([userId])
}

model Session {
  id                   String   @id @default(cuid())
  userId               String   @map("user_id")
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  patients     Patient[]
  appointments Appointment[]
  cashTransactions CashTransaction[]
  protocolAssessments ProtocolAssessment[]

  @@unique([slug])
  @@map("organization")
}

model Patient {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  notes          String            @default("")
  status         PatientStatus     @default(ativo)
  pricingType    PatientPricingType @default(sessao)
  priceCents     Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  evaluations    Evaluation[]
  anamnese       Anamnese?
  sessionNotes   SessionNote[]
  appointments   Appointment[]
  roteiroNotes   RoteiroNote[]
  cashTransactions CashTransaction[]
  protocolAssessments ProtocolAssessment[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("patients")
}

model Evaluation {
  id                String   @id @default(cuid())
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  memberId          String?
  member            Member?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  tipo              String   @default("inicial")
  date              String
  queixa            String   @default("")
  historia          String   @default("")
  domains           String
  objetivos         String   @default("")
  condutas          String   @default("")
  diagnostico       String   @default("")
  encaminhadoPor    String   @default("")
  contextoFamiliar  String   @default("")
  nivelPrevio       String   @default("")
  medicacoes        String   @default("")
  precaucoes        String   @default("")
  equipamentos      String   @default("")
  frequencia        String   @default("")
  criteriosAlta     String   @default("")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([patientId])
  @@index([patientId, date])
  @@index([memberId])
  @@map("evaluations")
}

model Anamnese {
  id        String   @id @default(cuid())
  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  data      String   @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("anamneses")
}

model SessionNote {
  id          String            @id @default(cuid())
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  memberId    String?
  member      Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  date        String
  status      SessionNoteStatus @default(compareceu)
  atividades  String            @default("")
  observacoes String            @default("")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([patientId])
  @@index([patientId, date])
  @@index([memberId])
  @@map("session_notes")
}

model Appointment {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  memberId       String
  member         Member            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  date           String
  time           String            @default("")
  duration       Int               @default(45)
  notes          String            @default("")
  status         AppointmentStatus @default(agendado)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId])
  @@index([organizationId, date])
  @@index([patientId])
  @@index([memberId])
  @@map("appointments")
}

model CashTransaction {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           CashTransactionType
  amountCents    Int
  date           String
  description    String              @default("")
  paymentMethod  CashPaymentMethod   @default(dinheiro)
  patientId      String?
  patient        Patient?            @relation(fields: [patientId], references: [id], onDelete: SetNull)
  memberId       String?
  member         Member?             @relation(fields: [memberId], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId])
  @@index([organizationId, date])
  @@index([patientId])
  @@index([memberId])
  @@map("cash_transactions")
}

model RoteiroNote {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  roteiroId    String
  categoryTick String
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([patientId, roteiroId, categoryTick])
  @@index([patientId])
  @@index([patientId, roteiroId])
  @@map("roteiro_notes")
}

model ProtocolAssessment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  memberId       String?
  member         Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  protocolId     String
  label          String       @default("Avaliação")
  date           String
  scores         String
  notes          String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([patientId])
  @@index([patientId, protocolId])
  @@index([memberId])
  @@map("protocol_assessments")
}

model Member {
  id                  String                @id
  organizationId      String
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId              String
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                Role                  @default(MEMBER)
  profession          String?
  registro            String?
  metadata            String?
  createdAt           DateTime
  appointments        Appointment[]
  cashTransactions    CashTransaction[]
  evaluations         Evaluation[]
  sessionNotes        SessionNote[]
  protocolAssessments ProtocolAssessment[]

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}
